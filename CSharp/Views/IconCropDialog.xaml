<ContentDialog
    x:Class="Launcher.Views.IconCropDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Обріжте іконку профілю"
    PrimaryButtonText="Застосувати"
    CloseButtonText="Скасувати"
    DefaultButton="Primary">

    <StackPanel Spacing="8" Width="420">
        <TextBlock Text="Перетягни рамку, розтягни за кутик - іконка завжди зберігається квадратом."
                   FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>

        <!-- Область з зображенням і рамкою кропу поверх нього. Розмір фіксований (400x400),
             зображення масштабується під нього через Stretch=Uniform, тому координати рамки
             рахуються відносно цього контейнера, а не оригінального файлу. -->
        <Grid x:Name="CropArea" Width="400" Height="400" Background="#22000000">
            <Image x:Name="SourceImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- Затемнення поза рамкою кропу: чотири прямокутники навколо CropRect. -->
            <Canvas x:Name="OverlayCanvas" Background="Transparent">
                <Rectangle x:Name="DimTop" Fill="#99000000"/>
                <Rectangle x:Name="DimBottom" Fill="#99000000"/>
                <Rectangle x:Name="DimLeft" Fill="#99000000"/>
                <Rectangle x:Name="DimRight" Fill="#99000000"/>

                <Rectangle x:Name="CropRect"
                           Stroke="White" StrokeThickness="2"
                           Fill="Transparent"
                           PointerPressed="CropRect_PointerPressed"
                           PointerMoved="Canvas_PointerMoved"
                           PointerReleased="Canvas_PointerReleased"/>

                <!-- Кутик для зміни розміру (тягнеться правий-нижній кут рамки). -->
                <Rectangle x:Name="ResizeHandle" Width="16" Height="16" Fill="White" RadiusX="2" RadiusY="2"
                           PointerPressed="ResizeHandle_PointerPressed"
                           PointerMoved="Canvas_PointerMoved"
                           PointerReleased="Canvas_PointerReleased"/>
            </Canvas>
        </Grid>
    </StackPanel>
</ContentDialog>
