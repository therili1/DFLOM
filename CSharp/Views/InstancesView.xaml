<Page
    x:Class="Launcher.Views.InstancesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Launcher.Models"
    xmlns:viewmodels="using:Launcher.ViewModels"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Керування Інсталяціями (Профілями)" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold"/>
                <TextBlock Text="Налаштовуйте виділення пам'яті, аргументи JVM та версії для кожного профілю окремо" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Створити Новий Профіль" Click="ShowCreateDialog_Click" Style="{ThemeResource AccentButtonStyle}"/>
        </Grid>

        <!-- Toolbar: search / sort / view mode / card size -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <AutoSuggestBox Grid.Column="0" PlaceholderText="Пошук за назвою, версією чи лоадером..." Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" QueryIcon="Find"/>
            <ComboBox Grid.Column="1" x:Name="SortCombo" SelectionChanged="SortCombo_SelectionChanged" MinWidth="160">
                <ComboBoxItem Content="За назвою" Tag="Name" IsSelected="True"/>
                <ComboBoxItem Content="Останній запуск" Tag="LastLaunched"/>
                <ComboBoxItem Content="За версією" Tag="Version"/>
            </ComboBox>
            <ComboBox Grid.Column="2" x:Name="CardSizeCombo" SelectionChanged="CardSizeCombo_SelectionChanged" MinWidth="120" Visibility="{x:Bind ViewModel.IsGridView, Mode=OneWay}">
                <ComboBoxItem Content="Small" Tag="Small"/>
                <ComboBoxItem Content="Medium" Tag="Medium" IsSelected="True"/>
                <ComboBoxItem Content="Large" Tag="Large"/>
            </ComboBox>
            <ToggleButton Grid.Column="3" x:Name="GridViewToggle" Content="&#xE80A;" FontFamily="Segoe MDL2 Assets" IsChecked="True" Click="GridViewToggle_Click" ToolTipService.ToolTip="Grid View"/>
            <ToggleButton Grid.Column="4" x:Name="ListViewToggle" Content="&#xE8FD;" FontFamily="Segoe MDL2 Assets" IsChecked="False" Click="ListViewToggle_Click" ToolTipService.ToolTip="List View"/>
        </Grid>

        <!-- Profiles & Settings Split -->
        <Grid Grid.Row="2" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="6*"/>
            </Grid.ColumnDefinitions>

            <!-- Left column: Grid View or List View of profiles -->
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Доступні збірки" FontWeight="Bold" Style="{ThemeResource BodyTextBlockStyle}"/>

                    <!-- Grid View: картки -->
                    <GridView Grid.Row="1" x:Name="InstancesGrid" ItemsSource="{x:Bind ViewModel.FilteredInstances, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedInstance, Mode=TwoWay}" SelectionMode="Single"
                              Visibility="{x:Bind ViewModel.IsGridView, Mode=OneWay}">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:MinecraftInstance">
                                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="12" Margin="4">
                                    <StackPanel Spacing="6">
                                        <Grid Height="72">
                                            <Image Source="{x:Bind CustomIcon, Converter={StaticResource PathToImageConverter}}" Stretch="UniformToFill"
                                                   Visibility="{x:Bind CustomIcon, Converter={StaticResource StringToVisibilityConverter}}"/>
                                            <TextBlock Text="{x:Bind Loader, Converter={StaticResource LoaderIconConverter}}" FontSize="40"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{x:Bind CustomIcon, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Invert}"/>
                                        </Grid>
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind Version}" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                        <TextBlock Text="{x:Bind Loader}" FontSize="11" Foreground="{ThemeResource SystemControlHighlightAccentBrush}"/>
                                        <TextBlock Text="{x:Bind Converter={StaticResource ModCountConverter}}" FontSize="10" Opacity="0.7"/>
                                        <TextBlock Text="{x:Bind Converter={StaticResource WorldCountConverter}}" FontSize="10" Opacity="0.7"/>
                                        <TextBlock Text="{x:Bind LastLaunched, Converter={StaticResource NullableDateTimeConverter}}" FontSize="10" Opacity="0.6"/>
                                        <Grid ColumnSpacing="6" Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Content="▶ Грати" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch"
                                                    Tag="{x:Bind}" Click="CardLaunch_Click"/>
                                            <Button Grid.Column="1" Content="&#x22EF;" Padding="8,4" Background="Transparent" BorderThickness="0" Tag="{x:Bind}" Click="InstanceOptions_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <!-- List View: компактний список -->
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.FilteredInstances, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedInstance, Mode=TwoWay}" SelectionMode="Single"
                              Visibility="{x:Bind ViewModel.IsGridView, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:MinecraftInstance">
                                <Grid ColumnSpacing="12" Padding="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Loader, Converter={StaticResource LoaderIconConverter}}" FontSize="20" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{x:Bind Version}" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Loader}" FontSize="11" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="3" Content="▶" Padding="8,4" Tag="{x:Bind}" Click="CardLaunch_Click"/>
                                    <Button Grid.Column="4" Content="&#x22EF;" FontSize="16" Padding="6,2" Background="Transparent" BorderThickness="0" Click="InstanceOptions_Click" Tag="{x:Bind}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Right column: Detailed settings of Selected Profile -->
            <Border Grid.Column="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid RowSpacing="16" Visibility="{x:Bind ViewModel.SelectedInstance, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Налаштування профілю" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="{x:Bind ViewModel.SelectedInstance.Name, Mode=OneWay}" FontSize="12" Opacity="0.8"/>
                    </StackPanel>

                    <!-- Scrollable form options -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="14" Padding="0,0,12,0">
                            <!-- Name input -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="Назва профілю" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                <TextBox Text="{x:Bind ViewModel.SelectedInstance.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Version and Loader info (ReadOnly) -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Версія гри" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                    <TextBox Text="{x:Bind ViewModel.SelectedInstance.Version, Mode=OneWay}" IsReadOnly="True"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Тип завантажувача" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                    <TextBox Text="{x:Bind ViewModel.SelectedInstance.Loader, Mode=OneWay}" IsReadOnly="True"/>
                                </StackPanel>
                            </Grid>

                            <!-- RAM allocation -->
                            <StackPanel Spacing="6">
                                <Grid>
                                    <TextBlock Text="Виділена оперативна пам'ять" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedInstance.AllocatedRAM, Mode=OneWay, Converter={StaticResource RamMbConverter}}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider Minimum="2048" Maximum="16384" StepFrequency="512" Value="{x:Bind ViewModel.SelectedInstance.AllocatedRAM, Mode=TwoWay}"/>
                            </StackPanel>

                            <!-- JVM Arguments -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="Аргументи JVM" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                <TextBox Text="{x:Bind ViewModel.SelectedInstance.JvmArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Profile Notes -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="Нотатки" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                <TextBox Text="{x:Bind ViewModel.SelectedInstance.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="80"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Save & Delete actions -->
                    <Grid Grid.Row="2" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Видалити Профіль" Foreground="Red" Click="DeleteInstance_Click"/>
                        <Button Grid.Column="2" Content="Зберегти Налаштування" Style="{ThemeResource AccentButtonStyle}" Click="SaveSettings_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
