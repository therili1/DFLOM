<Window
    x:Class="Launcher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:navigation="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Title="Minecraft Launcher - Fluent Edition">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar for true Fluent look -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Source="Assets/StoreLogo.png" Width="16" Height="16" Margin="16,0,8,0" Grid.Column="0"/>
            <TextBlock Text="Minecraft Launcher" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Grid.Column="1"/>
        </Grid>

        <!-- Main Shell Navigation Menu. MenuItems.Items наповнюється в коді (MainWindow.xaml.cs)
             з INavigationSettingsService - порядок/видимість/позиція керуються користувачем
             у Налаштуваннях і зберігаються між запусками. -->
        <NavigationView x:Name="MainNavView" Grid.Row="1" IsSettingsVisible="True" IsBackButtonVisible="Collapsed">
            <Frame x:Name="ContentFrame" Margin="24,12,24,24"/>
        </NavigationView>
    </Grid>
</Window>
