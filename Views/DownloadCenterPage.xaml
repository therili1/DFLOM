<Page
    x:Class="Launcher.Views.DownloadCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:Launcher.Services"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Центр Завантажень" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold"/>
                <TextBlock Text="Minecraft, Java, моди, модпаки, світи, датапаки, ресурспаки, шейдери, лоадери" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="⏸ Пауза всіх" Command="{x:Bind ViewModel.PauseAllCommand}"/>
                <Button Content="▶ Резюм всіх" Command="{x:Bind ViewModel.ResumeAllCommand}"/>
                <Button Content="✕ Скасувати всі" Foreground="Red" Command="{x:Bind ViewModel.CancelAllCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <AutoSuggestBox Grid.Column="0" PlaceholderText="Пошук за назвою файлу..." Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" QueryIcon="Find"/>
            <ComboBox Grid.Column="1" x:Name="SortCombo" SelectionChanged="SortCombo_SelectionChanged" MinWidth="180">
                <ComboBoxItem Content="Спочатку нові" Tag="Newest" IsSelected="True"/>
                <ComboBoxItem Content="За назвою" Tag="Name"/>
                <ComboBoxItem Content="За статусом" Tag="Status"/>
            </ComboBox>
        </Grid>

        <!-- Queue / History list -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{x:Bind ViewModel.FilteredQueue, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="services:DownloadTask">
                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <Border Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{x:Bind Category, Converter={StaticResource EnumToStringConverter}}" FontSize="10"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Status, Converter={StaticResource EnumToStringConverter}}" FontSize="12" Opacity="0.8"/>
                                </Grid>

                                <ProgressBar Grid.Row="1" Value="{x:Bind Progress, Mode=OneWay}" Minimum="0" Maximum="100"/>

                                <Grid Grid.Row="2" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Converter={StaticResource DownloadStatusLineConverter}}" FontSize="11" Opacity="0.7"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <Button Content="⏸" ToolTipService.ToolTip="Пауза" Tag="{x:Bind}" Click="Pause_Click" Visibility="{x:Bind Status, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Downloading}"/>
                                        <Button Content="▶" ToolTipService.ToolTip="Резюм" Tag="{x:Bind}" Click="Resume_Click" Visibility="{x:Bind Status, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Paused}"/>
                                        <Button Content="🔁" ToolTipService.ToolTip="Повторити" Tag="{x:Bind}" Click="Retry_Click" Visibility="{x:Bind Status, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Failed}"/>
                                        <Button Content="✕" ToolTipService.ToolTip="Скасувати" Tag="{x:Bind}" Click="Cancel_Click"/>
                                        <Button Content="📁" ToolTipService.ToolTip="Відкрити теку" Tag="{x:Bind}" Click="OpenFolder_Click"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Grid.Row="3" Text="{x:Bind ErrorMessage}" Foreground="Red" FontSize="11" TextWrapping="Wrap"
                                           Visibility="{x:Bind ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
