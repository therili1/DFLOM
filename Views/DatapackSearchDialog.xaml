<ContentDialog
    x:Class="Launcher.Views.DatapackSearchDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Launcher.Services"
    xmlns:local="using:Launcher.Views"
    mc:Ignorable="d"
    Title="Пошук датапаків для світу"
    PrimaryButtonText="Закрити"
    DefaultButton="Primary"
    MinWidth="720">

    <Grid RowSpacing="12" MaxHeight="520">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="WorldHeaderText" Grid.Row="0" FontSize="12" Opacity="0.7"/>

        <!-- Пошук + фільтр версій -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Пошук датапаків на Modrinth..." QueryIcon="Find" QuerySubmitted="SearchBox_QuerySubmitted"/>

            <DropDownButton Grid.Column="1" Content="Версія гри">
                <DropDownButton.Flyout>
                    <Flyout>
                        <StackPanel Spacing="4" MaxHeight="300">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="280">
                                <ItemsControl x:Name="VersionFilterList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:DatapackVersionOption">
                                            <CheckBox Content="{x:Bind Value}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <Button Grid.Column="2" Content="Шукати" Style="{ThemeResource AccentButtonStyle}" Click="Search_Click"/>
        </Grid>

        <!-- Результати -->
        <Grid Grid.Row="2">
            <ProgressRing x:Name="LoadingRing" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0" TextWrapping="Wrap"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ResultsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:MarketplaceProjectHeader">
                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="4" Width="36" Height="36" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
                                        <Image Source="{x:Bind IconUrl}" Stretch="UniformToFill"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Text="{x:Bind Description}" FontSize="10" Opacity="0.7" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Встановити" Click="Install_Click" Tag="{x:Bind}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</ContentDialog>
