<Page
    x:Class="Launcher.Views.WorldManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Launcher.Models"
    xmlns:viewmodels="using:Launcher.ViewModels"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Інтегрований Менеджер Світів (Saves Explorer)" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold"/>
                <TextBlock Text="Керуйте збереженнями світів усіх інсталяцій Minecraft безпосередньо в лаунчері" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Створити Світ" Style="{ThemeResource AccentButtonStyle}" Click="CreateWorld_Click"/>
        </Grid>

        <!-- Filters Row -->
        <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <AutoSuggestBox PlaceholderText="Пошук світу за назвою..." Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" QueryIcon="Find"/>
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" SelectedValue="{x:Bind ViewModel.FilterInstance, Mode=TwoWay}" SelectedValuePath="Tag">
                <ComboBoxItem Content="Всі Профілі" Tag="all" IsSelected="True"/>
            </ComboBox>
            <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" SelectedValue="{x:Bind ViewModel.FilterGameMode, Mode=TwoWay}" SelectedValuePath="Tag">
                <ComboBoxItem Content="Всі Режими" Tag="all" IsSelected="True"/>
                <ComboBoxItem Content="Survival" Tag="Survival"/>
                <ComboBoxItem Content="Creative" Tag="Creative"/>
                <ComboBoxItem Content="Hardcore" Tag="Hardcore"/>
            </ComboBox>
            <ComboBox Grid.Column="3" HorizontalAlignment="Stretch" SelectedValue="{x:Bind ViewModel.SortBy, Mode=TwoWay}" SelectedValuePath="Tag">
                <ComboBoxItem Content="Останній запуск" Tag="last_played" IsSelected="True"/>
                <ComboBoxItem Content="За назвою" Tag="name"/>
                <ComboBoxItem Content="За розміром" Tag="size"/>
            </ComboBox>
        </Grid>

        <!-- Main Content Area -->
        <Grid Grid.Row="2" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Grid of Worlds -->
            <Grid>
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <GridView ItemsSource="{x:Bind ViewModel.Worlds, Mode=OneWay}" SelectionMode="None">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:WorldItem">
                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Width="280" Margin="0,0,12,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="120"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Border CornerRadius="4" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" Width="48" Height="48" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Icon}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="Bold" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind Version}" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Скріншоти: мініатюра останнього + лічильник -->
                                    <Border Grid.Row="1" CornerRadius="6" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
                                        <Grid>
                                            <Image Source="{x:Bind LatestScreenshotPath, Converter={StaticResource PathToImageConverter}}"
                                                   Stretch="UniformToFill"
                                                   Visibility="{x:Bind ScreenshotCount, Converter={StaticResource CountToVisibilityConverter}}"/>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                        Visibility="{x:Bind ScreenshotCount, Converter={StaticResource ZeroCountToVisibilityConverter}}">
                                                <FontIcon Glyph="&#xE91B;" FontSize="20" Opacity="0.5"/>
                                                <TextBlock Text="Скріншотів немає" FontSize="10" Opacity="0.5" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Background="#AA000000" CornerRadius="4" Padding="6,2" Margin="6">
                                                <TextBlock Text="{x:Bind ScreenshotCount}" FontSize="11" Foreground="White"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Row="2" Spacing="4">
                                        <TextBlock Text="{x:Bind Gamemode}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlHighlightAccentBrush}"/>
                                        <TextBlock Text="{x:Bind Seed, Converter={StaticResource StringFormatConverter}, ConverterParameter='Seed: {0}'}" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7"/>
                                    </StackPanel>

                                    <!-- Датапаки: лічильник + кнопка додавання -->
                                    <Grid Grid.Row="3" ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" FontSize="11" Opacity="0.8"
                                                   Text="{x:Bind DatapackCount, Converter={StaticResource StringFormatConverter}, ConverterParameter='Датапаків: {0}'}"/>
                                        <Button Grid.Column="1" Content="+ Датапак" FontSize="11" Padding="8,4" Click="AddDatapack_Click"/>
                                    </Grid>

                                    <Grid Grid.Row="4" ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Content="Запуск" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch"/>
                                        <Button Grid.Column="1" Content="Backup" Click="BackupWorld_Click"/>
                                        <Button Grid.Column="2" Content="Del" Foreground="Red" Click="DeleteWorld_Click"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>

            <!-- Right: Drag and Drop Sidebar -->
            <StackPanel Grid.Column="1" Spacing="16">
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="2" CornerRadius="8" Padding="24" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" MinHeight="220" AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZone_Drop">
                    <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE896;" FontSize="40" Foreground="{ThemeResource SystemControlHighlightAccentBrush}"/>
                        <TextBlock Text="Drag &amp; Drop Світ (.zip)" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Перетягніть архів світу сюди для автоматичного імпорту в лаунчер" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Стан Резервних Копій" FontWeight="Bold" Style="{ThemeResource BodyTextBlockStyle}"/>
                        <TextBlock Text="Автоматичне резервне копіювання світів активоване перед кожним запуском. Кількість збережених копій: 5" FontSize="11" TextWrapping="Wrap" Opacity="0.8"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
