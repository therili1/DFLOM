<Page
    x:Class="Launcher.Views.LogsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Консоль Логів &amp; Термінал клієнту" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold"/>
                <TextBlock Text="Моніторинг виводу stdout/stderr процесу гри в реальному часі для виправлення крашів" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
            </StackPanel>
        </Grid>

        <!-- Filters -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <AutoSuggestBox PlaceholderText="Пошук у рядках логів..." QueryIcon="Find" x:Name="SearchBox" QuerySubmitted="SearchBox_QuerySubmitted"/>
            
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0" x:Name="LogLevelCombo" SelectionChanged="LogLevelCombo_SelectionChanged">
                <ComboBoxItem Content="Всі Рівні логів"/>
                <ComboBoxItem Content="INFO"/>
                <ComboBoxItem Content="WARNING"/>
                <ComboBoxItem Content="ERROR"/>
            </ComboBox>

            <Button Grid.Column="2" Content="Очистити Консоль" Click="Clear_Click"/>
            <Button Grid.Column="3" Content="Копіювати Лог" Style="{ThemeResource AccentButtonStyle}" Click="Copy_Click"/>
        </Grid>

        <!-- Logs Box -->
        <Border Grid.Row="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="Black" Padding="12">
            <ScrollViewer x:Name="LogsScroll" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="LogsTextBox" 
                           FontFamily="Consolas" 
                           FontSize="13" 
                           Foreground="LightGray" 
                           TextWrapping="Wrap" 
                           LineHeight="18" 
                           IsTextSelectionEnabled="True"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
