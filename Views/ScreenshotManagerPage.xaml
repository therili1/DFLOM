<Page
    x:Class="Launcher.Views.ScreenshotManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Launcher.Models"
    xmlns:viewmodels="using:Launcher.ViewModels"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Менеджер Скріншотів" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold"/>
                <TextBlock Text="Переглядайте, видаляйте та імпортуйте знімки екрана ваших інсталяцій Minecraft" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
            </StackPanel>
        </Grid>

        <!-- Filters -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ComboBox HorizontalAlignment="Stretch" SelectedValue="{x:Bind ViewModel.FilterInstance, Mode=TwoWay}" SelectedValuePath="Tag">
                <ComboBoxItem Content="Всі Профілі" Tag="all" IsSelected="True"/>
            </ComboBox>
            <Button Grid.Column="1" Content="Імпортувати Скріншот" Click="ImportScreenshot_Click" HorizontalAlignment="Right"/>
        </Grid>

        <!-- Content Gallery -->
        <Grid Grid.Row="2" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Gallery Grid -->
            <Grid>
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <GridView ItemsSource="{x:Bind ViewModel.Screenshots, Mode=OneWay}" SelectionMode="None">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:ScreenshotItem">
                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Width="260" Margin="0,0,12,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="150"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Image Source="{x:Bind ImageUrl}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Row="1" Padding="12" Spacing="4">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" Style="{ThemeResource BodyTextBlockStyle}" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind CapturedAt, Converter={StaticResource DateTimeToStringConverter}}" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                        <Grid Margin="0,8,0,0">
                                            <Button Content="Видалити" Foreground="Red" FontSize="11" Click="DeleteScreenshot_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>

            <!-- Sidebar -->
            <StackPanel Grid.Column="1" Spacing="16">
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="2" CornerRadius="8" Padding="24" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" MinHeight="220" AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZone_Drop">
                    <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xEB9F;" FontSize="40" Foreground="{ThemeResource SystemControlHighlightAccentBrush}"/>
                        <TextBlock Text="Завантажити скріншот" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Перетягніть файли зображень сюди для імпорту в галерею" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
